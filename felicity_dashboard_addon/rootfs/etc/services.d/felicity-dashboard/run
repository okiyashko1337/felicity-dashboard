#!/usr/bin/with-contenv bashio

declare inverter_host
declare inverter_port
declare poll_interval
declare expected_bms_packets
declare system_interval
declare nextion_enabled
declare nextion_port
declare nextion_baudrate

inverter_host=$(bashio::config 'inverter_host')
inverter_port=$(bashio::config 'inverter_port')
poll_interval=$(bashio::config 'poll_interval')
expected_bms_packets=$(bashio::config 'expected_bms_packets')
if [[ -z "${expected_bms_packets}" || "${expected_bms_packets}" == "null" ]]; then
    expected_bms_packets=2
fi
system_interval=$(bashio::config 'system_interval')
nextion_enabled=$(bashio::config 'nextion_enabled')
nextion_port=$(bashio::config 'nextion_port')
nextion_baudrate=$(bashio::config 'nextion_baudrate')

export FELICITY_HOST="${inverter_host}"
export FELICITY_PORT="${inverter_port}"
export FELICITY_POLL_INTERVAL_SECONDS="${poll_interval}"
export FELICITY_EXPECTED_BMS_PACKETS="${expected_bms_packets}"
export FELICITY_DB_PATH="/data/felicity.db"
export FELICITY_DEVICE_UPDATE_STATE="/data/device-update.json"
export PYTHONUNBUFFERED="1"

bashio::log.info "Starting Felicity collector for ${inverter_host}:${inverter_port}"
bashio::log.info "Telemetry: ${poll_interval}s; expected BMS packets: ${expected_bms_packets}; Raspberry Pi metrics: ${system_interval}s"

cd /app || exit 1

bashio::log.info "Checking compact telemetry storage"
/opt/felicity-venv/bin/python storage_migration.py || exit 1

/opt/felicity-venv/bin/python collector.py &
collector_pid=$!
/opt/felicity-venv/bin/python system_monitor.py --interval "${system_interval}" &
monitor_pid=$!
/opt/felicity-venv/bin/uvicorn main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --no-access-log \
    --proxy-headers &
web_pid=$!

nextion_pid=""
if [[ "${nextion_enabled}" == "true" ]]; then
    if [[ -z "${nextion_port}" ]]; then
        bashio::log.warning "Nextion is enabled, but nextion_port is empty"
    else
        bashio::log.info "Starting Nextion on ${nextion_port} at ${nextion_baudrate} baud"
        /opt/felicity-venv/bin/python nextion_bridge.py \
            --port "${nextion_port}" \
            --baudrate "${nextion_baudrate}" \
            --interval "${poll_interval}" &
        nextion_pid=$!
    fi
fi

shutdown() {
    bashio::log.info "Stopping Felicity Dashboard"
    kill -TERM "${collector_pid}" "${monitor_pid}" "${web_pid}" 2>/dev/null || true
    if [[ -n "${nextion_pid}" ]]; then
        kill -TERM "${nextion_pid}" 2>/dev/null || true
    fi
    wait "${collector_pid}" "${monitor_pid}" "${web_pid}" 2>/dev/null || true
    if [[ -n "${nextion_pid}" ]]; then
        wait "${nextion_pid}" 2>/dev/null || true
    fi
}

trap shutdown SIGTERM SIGINT
wait -n
exit_code=$?
shutdown
exit "${exit_code}"

[Unit]
Description=Felicity FastAPI dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/felicity-dashboard
EnvironmentFile=-/opt/felicity-dashboard/felicity.env
ExecStart=/opt/felicity-dashboard/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
